configuration {
    show-icons: false;
}

* {
    glass-bg:              rgba(0, 0, 0, 0.45);
    glass-panel:           rgba(255, 255, 255, 0.06);
    glass-panel-selected:  rgba(255, 255, 255, 0.14);
    glass-edge:            rgba(255, 255, 255, 0.15);

    text-main:             #dcdccc;
    accent-pink:           #ff1493;

    listview-spacing:      8px;
    element-padding:       16px 0px;
    element-border-radius: 4px;

    element-text-font:     "JetBrainsMono Nerd Font 24";

    background-normal:     @glass-panel;
    background-selected:   @glass-panel-selected;
    foreground-normal:     @text-main;
    foreground-selected:   @accent-pink;
}

window {
    transparency: "real";
    location: west;
    anchor: west;
    x-offset: 20px;
    fullscreen: false;
    width: 80px;
    cursor: "default";
    background-color: transparent;
    border: 0px;
}

mainbox {
    enabled: true;
    spacing: 0px;
    margin: 0px;
    padding: 12px;
    background-color: @glass-bg;
    border: 1px;
    border-color: @glass-edge;
    border-radius: 4px;
    children: [ "listview" ];
}

listview {
    enabled: true;
    expand: false;
    columns: 1;
    lines: 5;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    reverse: false;
    fixed-height: true;
    fixed-columns: true;
    spacing: @listview-spacing;
    background-color: transparent;
    cursor: "default";
}

element {
    enabled: true;
    padding: @element-padding;
    border-radius: @element-border-radius;
    background-color: @background-normal;
    text-color: @foreground-normal;
    border: 1px;
    border-color: @glass-edge;
    cursor: pointer;
}

element-text {
    font: @element-text-font;
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.36;
}

element selected.normal {
    background-color: @background-selected;
    text-color: @foreground-selected;
    border-color: @accent-pink;
}
